# Copie este arquivo para .env e preencha os valores (nunca commite o .env).
# Ver docs/03-diretriz-arquitetura.md e docs/04-arquitetura.md.

# === Acesso ao Gemini (AI Studio por padrão) ===
GEMINI_API_KEY=

# FALSE = usa Gemini API (AI Studio, chave acima). TRUE = usa Vertex AI (ADC/IAM).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Apenas quando GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# === Modelos por papel (divisão de trabalho, docs/03) ===
# O nome fala do papel, não do modelo: trocar o modelo não engana ninguém.
GEMINI_MODELO_TRIAGEM=gemini-3.5-flash-lite
GEMINI_MODELO_RESPOSTA=gemini-3.8-flash
GEMINI_MODEL_EMBEDDING=gemini-embedding-001
# Failover da composição: quando a cota do RESPOSTA esgota (429/503/504 após o
# retry), o turno retoma neste modelo. Vazio = failover desligado.
GEMINI_MODELO_RESPOSTA_FALLBACK=

# === Modo de execução do LLM ===
# real    = chama a API de verdade e NÃO grava nada (gasta cota)
# gravar  = chama a API e grava a resposta completa em tests/fixtures (só p/ grava)
# fixture = reproduz respostas gravadas em tests/fixtures (sem chamada à API)
LLM_MODO=real

# === Índice vetorial local (RAG) ===
RAG_INDEX_DIR=.rag_index

# === Relógio da sessão do assistente (etapa 12) ===
# Vazio = data real de hoje. A demo pode simular o dia do dataset (2026-10-30).
DATA_REFERENCIA=
