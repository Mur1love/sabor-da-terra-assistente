# Copie este arquivo para .env e preencha os valores (nunca commite o .env).
# Ver docs/03-diretriz-arquitetura.md e docs/04-arquitetura.md.

# === Acesso ao Gemini (AI Studio por padrão) ===
GEMINI_API_KEY=

# FALSE = usa Gemini API (AI Studio, chave acima). TRUE = usa Vertex AI (ADC/IAM).
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Apenas quando GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# === Modelos por papel (divisão de trabalho, docs/03) ===
GEMINI_MODEL_FLASH_LITE=gemini-3.5-flash-lite
GEMINI_MODEL_FLASH=gemini-3.8-flash
GEMINI_MODEL_EMBEDDING=gemini-embedding-001

# === Modo de execução do LLM ===
# real    = chama a API de verdade (gasta cota)
# fixture = reutiliza respostas gravadas em tests/fixtures (sem chamada à API)
LLM_MODO=real

# === Índice vetorial local (RAG) ===
RAG_INDEX_DIR=.rag_index
